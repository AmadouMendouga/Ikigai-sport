{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "create:admin": "node scripts/create-admin.mjs",
    "test": "node --experimental-strip-types --test tests/lib.test.mjs tests/critical-actions.test.mjs tests/campay-retry.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-le-maillot-ideal-test --only firestore \"node --experimental-strip-types --test tests/firestore-rules.test.mjs\"",
    "test:browser": "npm run build && node tests/browser-audit.mjs",
    "check": "npm run lint && npm run test && npm run test:rules && npm run test:browser"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@types/leaflet": "^1.9.22",
    "@vercel/analytics": "^2.0.1",
    "cloudinary": "^2.11.0",
    "firebase": "^12.4.0",
    "firebase-admin": "14.4.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.9.0",
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "firebase-tools": "^15.28.2",
    "playwright": "1.62.1",
    "typescript": "^5"
  }
}
