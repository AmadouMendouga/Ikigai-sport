rules_version = '2';

// Toutes les écritures passent par les Server Actions Next.js (Admin SDK, qui
// contourne ces règles côté serveur) — jamais d'écriture directe du client.
// Voir web/lib/firebase/admin.ts et le plan §3.
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if false;
    }
    match /sports/{sportId} {
      allow read: if true;
      allow write: if false;
    }
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if false;
    }
    match /testimonials/{itemId} {
      allow read: if true;
      allow write: if false;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Commandes et avis en attente de validation (addendum suivi de commandes) :
    // fermées en lecture ET en écriture, y compris pour un client authentifié —
    // tout accès (dont la page publique /avis/[token]) passe par une Server
    // Action (Admin SDK), jamais par une lecture Firestore directe. Un client ne
    // doit jamais pouvoir lister les commandes ou lire l'avis d'un autre.
    match /orders/{orderId} {
      allow read, write: if false;
    }
    match /testimonialSubmissions/{submissionId} {
      allow read, write: if false;
    }
    // Comptes clients (addendum 2). Comme orders, tout accès passe par les
    // Server Actions (Admin SDK) — même un client connecté ne lit jamais son
    // propre profil directement via le SDK client.
    match /customers/{uid} {
      allow read, write: if false;
    }

    // Compteurs de tentatives de connexion (rate limiting sur /api/session).
    // Accessible uniquement via l'Admin SDK (jamais par le client) — le catch-all
    // ci-dessous suffirait, mais être explicite évite toute ambiguïté.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Tout le reste (futures collections users en Phase 2/3) : fermé par
    // défaut tant que la logique n'est pas explicitement écrite ici.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
